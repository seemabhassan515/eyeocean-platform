# Meilisearch (search provider — see src/lib/search.ts)
# Local dev: run `npm run meilisearch:up` to start a Docker container, which
# prints/generates a master key for you to copy here as MEILI_API_KEY.
# Production: point these at a hosted Meilisearch instance (Meilisearch Cloud
# or your own server) and use a scoped API key, not the master key.
MEILI_HOST=http://127.0.0.1:7700
MEILI_API_KEY=

# Postgres (database — see prisma/schema.prisma)
# Local dev: run `npm run postgres:up` (or `npm run infra:up`) to start a
# Docker container, then point this at it, e.g.
# postgresql://postgres:<password>@localhost:5432/eyeocean
# Production: point this at your hosted Postgres instance. If deploying to a
# serverless host (Vercel, etc.), use a POOLED connection string, not a
# direct one — each function invocation opens its own connection, and a
# burst of traffic can exhaust Postgres's connection limit otherwise.
# Managed Postgres providers (Neon, Supabase, RDS Proxy, etc.) all offer a
# pooled connection string for exactly this; use that one here, and prefer
# their session-mode pooler over transaction-mode if you hit prepared
# statement errors.
DATABASE_URL=

# Session signing secret (see src/lib/auth.ts) — HMAC-signs the login session
# cookie. Generate one with: openssl rand -hex 32
# Rotating this logs every signed-in customer out.
SESSION_SECRET=

# Stripe (checkout — see src/lib/stripe.ts, src/app/api/checkout,
# src/app/api/webhooks/stripe)
# Get test-mode keys from https://dashboard.stripe.com/test/apikeys (no
# business verification needed for test mode). Never put live keys here.
STRIPE_SECRET_KEY=

# Signs webhook requests so /api/webhooks/stripe can trust they're really
# from Stripe. Local dev: run `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe` (Stripe CLI) — it prints a
# whsec_... value to use here. In the Stripe Dashboard (for a deployed app):
# Developers -> Webhooks -> Add endpoint -> pick checkout.session.completed.
STRIPE_WEBHOOK_SECRET=

# Public site URL (see src/lib/site.ts) — used for canonical URLs, Open Graph
# tags, JSON-LD, and the sitemap. Defaults to http://localhost:3100 if unset.
# Set this to your real deployed domain (no trailing slash) in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
